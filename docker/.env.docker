# Backend Configuration
SECRET_KEY=your-super-secret-key-generate-with-secrets.token_urlsafe-32
ENVIRONMENT=production

# PostgreSQL Configuration
POSTGRES_USER=healthcare_user
POSTGRES_PASSWORD=healthcare_password
POSTGRES_DB=healthcare
DATABASE_URL=postgresql://healthcare_user:healthcare_password@postgres:5432/healthcare

# Redis Configuration
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_ATTEMPTS=3
RATE_LIMIT_WINDOW_MINUTES=15

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO
